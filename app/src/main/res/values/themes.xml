<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SCViewer" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/sc_background</item>
        <item name="android:colorBackground">@color/sc_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="colorPrimary">@color/sc_accent</item>
        <item name="colorPrimaryDark">@color/sc_background</item>
        <item name="colorAccent">@color/sc_accent</item>
        <item name="android:textColorPrimary">@color/sc_text_primary</item>
        <item name="android:textColorSecondary">@color/sc_text_secondary</item>
    </style>

    <!-- Overlay dialog theme — must extend a *Dialog* parent, not NoActionBar
         (which is an activity theme). Using NoActionBar here would crash with
         "requestFeature() must be called before adding content" when the
         Dialog tries to inflate. -->
    <style name="SCOverlay" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@color/sc_background_overlay</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:colorBackground">@color/sc_background_overlay</item>
        <item name="android:textColorPrimary">@color/sc_text_primary</item>
        <item name="android:textColorSecondary">@color/sc_text_secondary</item>
        <item name="colorAccent">@color/sc_accent</item>
    </style>

    <style name="SCListItem">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/sc_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="SCTitle">
        <item name="android:textColor">@color/sc_text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
