<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SCViewer" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/sctv_bg_obsidian</item>
        <item name="android:colorBackground">@color/sctv_bg_obsidian</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="colorPrimary">@color/sctv_accent</item>
        <item name="colorPrimaryDark">@color/sctv_bg_obsidian</item>
        <item name="colorAccent">@color/sctv_accent</item>
        <item name="android:textColorPrimary">@color/sctv_text_primary</item>
        <item name="android:textColorSecondary">@color/sctv_text_secondary</item>
    </style>

    <style name="SCOverlay" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:textColorPrimary">@color/sctv_text_primary</item>
        <item name="android:textColorSecondary">@color/sctv_text_secondary</item>
        <item name="colorAccent">@color/sctv_accent</item>
    </style>

    <style name="SCListItem">
        <item name="android:textColor">@color/sctv_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:focusable">false</item>
        <item name="android:clickable">false</item>
    </style>

    <style name="SCTitle">
        <item name="android:textColor">@color/sctv_text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
