<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: dark tile with a red rounded badge and a white play
     triangle — matches the Fire TV banner lock-up. Used directly as
     android:icon (the Fire TV home row shows the 16:9 banner instead). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- background tile -->
    <path android:fillColor="#FF141419" android:pathData="M0,0h108v108h-108z" />

    <!-- red badge, centred with generous margin (survives round masks) -->
    <path android:fillColor="#FFE50914"
          android:pathData="M31,31 h46 a12,12 0 0 1 12,12 v46 a12,12 0 0 1 -12,12 h-46 a12,12 0 0 1 -12,-12 v-46 a12,12 0 0 1 12,-12 z" />

    <!-- white play triangle -->
    <path android:fillColor="#FFFFFFFF"
          android:pathData="M48,45 L48,75 L72,60 Z" />
</vector>
