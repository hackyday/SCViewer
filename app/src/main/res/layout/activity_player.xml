<?xml version="1.0" encoding="utf-8"?>
<!-- Schermata di streaming SCtv: player reale del sito a tutto schermo con
     controlli nativi in stile design, navigabili col D-pad, senza mouse. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <WebView
        android:id="@+id/playerWeb"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Copertura nera anti-flash (M4b): lo stage1 del player carica la HOME
         del sito per stabilire i cookie — senza questo overlay l'utente vede
         per un attimo l'interfaccia del sito. È una VIEW sopra la WebView
         (non visibility=INVISIBLE sulla WebView) perché il video deve
         continuare a rendersi quando l'overlay viene rimosso; viene tolta
         solo quando il watch URL / l'embed inizia davvero a caricarsi. -->
    <View
        android:id="@+id/playerBlackout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black" />

    <!-- Vignette superiore -->
    <View
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="top"
        android:background="@drawable/player_gradient_top" />

    <!-- Barra superiore -->
    <LinearLayout
        android:id="@+id/playerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingTop="18dp"
        android:paddingEnd="28dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/playerBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/player_focus"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:text="‹  Back to Browse"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingTop="18dp">

        <TextView
            android:id="@+id/playerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/playerEpisode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/sc_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Vignette inferiore -->
    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/player_gradient_bottom" />

    <!-- Salta Intro -->
    <TextView
        android:id="@+id/playerSkipIntro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="150dp"
        android:background="@drawable/player_focus"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp"
        android:text="Skip Intro  ▸▸"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="@color/white"
        android:visibility="gone" />

    <!-- Prossimo episodio -->
    <LinearLayout
        android:id="@+id/playerNextCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="150dp"
        android:background="@drawable/player_pill"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/playerNextLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Up Next"
            android:textColor="@color/sc_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/playerNextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/playerNextPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/player_focus"
                android:paddingStart="16dp"
                android:paddingTop="9dp"
                android:paddingEnd="16dp"
                android:paddingBottom="9dp"
                android:text="▶  Play Now"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/white" />

            <TextView
                android:id="@+id/playerNextCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/player_focus"
                android:paddingStart="16dp"
                android:paddingTop="9dp"
                android:paddingEnd="16dp"
                android:paddingBottom="9dp"
                android:text="Cancel"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Indicatore SCRUB MODE (solo direct): mostra la posizione TARGET mentre
         il video è in pausa durante lo scrub dei tasti media (REW/FFWD tenuti).
         OK conferma il seek al target, BACK annulla. Centrato e grande, stile
         pillola degli altri controlli nativi. -->
    <LinearLayout
        android:id="@+id/playerScrubBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/player_pill"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="16dp"
        android:paddingEnd="30dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/playerScrubTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶▶ 00:00"
            android:textColor="@color/white"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/playerScrubHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="OK conferma · BACK annulla"
            android:textColor="@color/sc_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Controlli inferiori -->
    <LinearLayout
        android:id="@+id/playerBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/playerTimeCur"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="00:00"
                android:textColor="@color/sc_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/playerScrubber"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:max="100"
                android:progressBackgroundTint="#40FFFFFF"
                android:progressTint="@color/sc_accent" />

            <TextView
                android:id="@+id/playerTimeTot"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/sc_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/playerPlay"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/player_focus"
                android:backgroundTint="@color/white"
                android:gravity="center"
                android:text="▶"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/playerRew"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/player_focus"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="⟲ 10"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/playerFfw"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/player_focus"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="10 ⟳"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- FIX audio (direct mode SOLO): bottone MUTO — corregge in un
                 tap il mute che a volte sopravvive alla prima riproduzione.
                 GONE in legacy (nessun bridge JW → nessun controllo mute). -->
            <TextView
                android:id="@+id/playerMute"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/player_focus"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="AUDIO"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- M4b: cambio lingua audio (parametro lang dell'embed vixcloud).
                 Gli SOTTOTITOLI non hanno supporto parametrico nell'embed
                 (verificato nei bundle vixcloud: solo lang/canPlayFHD/scz/
                 minute/nextEpisode/referer) → restano nel menu ⚙ del player. -->
            <TextView
                android:id="@+id/playerLang"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/player_focus"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="LINGUA"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
