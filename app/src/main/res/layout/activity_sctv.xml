<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sctv_bg_obsidian">

    <!-- Interfaccia SCtv: l'HTML/JS vive in assets/sctv/ e dialoga via bridge -->
    <WebView
        android:id="@+id/sctvWeb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Studio Loading Overlay: copre il bootstrap della WebView (splash +
         profili) nello stesso stile dell'interfaccia sito. -->
    <FrameLayout
        android:id="@+id/sctvLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sctv_bg_obsidian"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_sctv_logo" />

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="@color/sctv_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/loading"
                android:textColor="@color/sctv_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Cast (C1, solo phone mode): bottone routing Chromecast in alto a
         destra. GONE di default: SctvActivity lo rende VISIBLE SOLO se il
         device è un telefono con Google Play services — su Fire TV resta
         GONE e nessun codice cast viene istanziato. -->
    <FrameLayout
        android:id="@+id/sctvCastBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_sctv_card"
        android:elevation="14dp"
        android:padding="10dp"
        android:visibility="gone">

        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/sctvCastRoute"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/remote_title" />
    </FrameLayout>

    <!-- Cast (C2): host della WebView headless usata da StreamResolver per
         estrarre window.masterPlaylist dall'embed vixcloud. 64dp, invisibile
         (INVISIBLE e non GONE: il layout/timer JS deve girare); la WebView
         vera viene aggiunta/tolta programmaticamente a ogni risoluzione. -->
    <FrameLayout
        android:id="@+id/sctvCastWebHost"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:elevation="13dp"
        android:visibility="invisible" />

</FrameLayout>
