<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sc_background"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Riga superiore: icona cast (scelta dispositivo) + titolo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/castRouteBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:mediaRouteTypes="user" />

        <TextView
            android:id="@+id/castTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/sc_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tempi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/castPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@color/sc_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/castDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="/ 0:00"
            android:textColor="@color/sc_text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Seekbar -->
    <SeekBar
        android:id="@+id/castSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:progressTint="@color/sc_accent"
        android:thumbTint="@color/sc_accent" />

    <!-- Trasporto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/castMinus30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-30s" />

        <Button
            android:id="@+id/castMinus10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="-10s" />

        <Button
            android:id="@+id/castPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/sc_accent"
            android:minWidth="110dp"
            android:text="@string/cast_play"
            android:textColor="@color/sc_text_primary" />

        <Button
            android:id="@+id/castPlus10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="+10s" />

        <Button
            android:id="@+id/castPlus30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="+30s" />
    </LinearLayout>

    <!-- Interrompi -->
    <Button
        android:id="@+id/castStop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:text="@string/cast_stop"
        android:textColor="@color/sc_accent"
        android:background="?attr/selectableItemBackground" />
</LinearLayout>
