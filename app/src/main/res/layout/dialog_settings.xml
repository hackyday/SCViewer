<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="580dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sctv_card"
            android:orientation="vertical"
            android:padding="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sctv_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textColor="@color/sctv_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Interfaccia primaria: SCtv nativa o sito classico. Il cambio
                 di modalità salva SOLO con Salva e (se cambia) fa da trigger
                 al routing via onSaved(modeChanged). -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_ui_label"
                android:textColor="@color/sctv_text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/settingsModeSctv"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_sctv_button_primary"
                    android:text="@string/settings_ui_sctv"
                    android:textAllCaps="false"
                    android:textColor="@color/sctv_text_primary"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/settingsModeSite"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_sctv_button_ghost"
                    android:text="@string/settings_ui_site"
                    android:textAllCaps="false"
                    android:textColor="@color/sctv_text_secondary" />
            </LinearLayout>

            <!-- Qualità massima: ha senso in ENTRAMBE le modalità (il cap
                 vive in HlsRewriter usato dal player del sito e dal nativo). -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/settings_quality_label"
                android:textColor="@color/sctv_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/settingsQualityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/sctv_accent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/settingsQualitySeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:focusable="true"
                android:max="2"
                android:progressBackgroundTint="#33FFFFFF"
                android:progressTint="@color/sctv_accent"
                android:thumbTint="@color/sctv_accent" />

            <!-- Sezione puntatore (velocità + nav sito): ha senso SOLO in
                 modalità sito — in SCtv non esiste cursore né pagina web. -->
            <LinearLayout
                android:id="@+id/settingsPointerSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/settings_speed_label"
                    android:textColor="@color/sctv_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/settingsSpeedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/sctv_accent"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/settingsSpeedSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:progressBackgroundTint="#33FFFFFF"
                    android:progressTint="@color/sctv_accent"
                    android:thumbTint="@color/sctv_accent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_nav_label"
                        android:textColor="@color/sctv_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/settingsNavToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_sctv_button_ghost"
                        android:minWidth="180dp"
                        android:text="@string/settings_nav_dpad"
                        android:textAllCaps="false"
                        android:textColor="@color/sctv_text_primary" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/settings_nav_hint"
                    android:textColor="@color/sctv_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Sezione UA alternativo: rilevante solo per il sito. -->
            <LinearLayout
                android:id="@+id/settingsUaSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_ua_label"
                        android:textColor="@color/sctv_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/settingsUaToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_sctv_button_ghost"
                        android:minWidth="124dp"
                        android:text="@string/settings_ua_off"
                        android:textAllCaps="false"
                        android:textColor="@color/sctv_text_primary" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/settings_ua_hint"
                    android:textColor="@color/sctv_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Cast Chromecast (C1): App ID del receiver CUSTOM. Vuoto =
                 Default Media Receiver (percorso 1). Solo phone mode usa il
                 cast: su Fire TV questa voce resta inerte. -->
            <LinearLayout
                android:id="@+id/settingsCastSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/settings_cast_label"
                    android:textColor="@color/sctv_text_secondary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/settingsCastAppId"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_sctv_card"
                    android:hint="@string/settings_cast_hint_short"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/sctv_text_primary"
                    android:textColorHint="@color/sctv_text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/settings_cast_hint"
                    android:textColor="@color/sctv_text_muted"
                    android:textSize="13sp" />

                <!-- DEBUG ONLY: cast finto (RemoteMediaClient stub locale)
                     per provare il telecomando senza Chromecast. Nascosto nei
                     build release. -->
                <Button
                    android:id="@+id/settingsCastFakeToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_sctv_button_ghost"
                    android:minWidth="200dp"
                    android:text="@string/settings_cast_fake_off"
                    android:textAllCaps="false"
                    android:textColor="@color/sctv_text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/settingsCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_sctv_button_ghost"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/settings_cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/sctv_text_secondary" />

                <Button
                    android:id="@+id/settingsSave"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_sctv_button_primary"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="@string/settings_save"
                    android:textAllCaps="false"
                    android:textColor="@color/sctv_text_primary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
