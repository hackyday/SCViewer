<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sc_background_overlay"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="@dimen/overlay_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/overlay_rounded"
        android:padding="@dimen/overlay_padding">

        <TextView
            android:id="@+id/overlayTitle"
            style="@style/SCTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/favorites_title" />

        <ListView
            android:id="@+id/overlayList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="200dp"
            android:divider="@color/sc_divider"
            android:dividerHeight="1dp"
            android:listSelector="@color/sc_accent_pressed" />

        <TextView
            android:id="@+id/overlayEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/sc_text_hint"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/overlayClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:text="@android:string/cancel"
                android:textColor="@color/sc_text_secondary" />

            <Button
                android:id="@+id/overlayAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/sc_accent"
                android:text="@string/menu_favorites"
                android:textColor="@color/sc_text_primary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
