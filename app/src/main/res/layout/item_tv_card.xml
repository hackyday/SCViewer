<?xml version="1.0" encoding="utf-8"?>
<!-- Poster card: 2:3 con nome sotto, bordo rosso quando a fuoco. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="118dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:foreground="@drawable/tv_card_focus"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="165dp"
        android:background="@color/sc_background_elevated"
        android:foreground="@drawable/tv_card_focus">

        <ImageView
            android:id="@+id/tvCardPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvCardScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="#CC000000"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="@color/sc_text_primary"
            android:textSize="11sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvCardName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/sc_text_secondary"
        android:textSize="12sp" />
</LinearLayout>
