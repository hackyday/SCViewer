<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sctv_bg_obsidian">

    <!-- Main WebView shifted right by collapsed sidebar width on TV -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/sctv_rail_collapsed_width"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Collapsible D-pad Sidebar Rail (TV) -->
    <include
        layout="@layout/view_tv_sidebar" />

    <!-- Floating Top Domain Status Pill -->
    <LinearLayout
        android:id="@+id/topStrip"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_sctv_chip"
        android:elevation="9dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ic_sctv_logo" />

        <TextView
            android:id="@+id/domainLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/sctv_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Studio Loading Overlay -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sctv_bg_obsidian"
        android:elevation="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_sctv_logo" />

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="@color/sctv_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/loading"
                android:textColor="@color/sctv_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Skip Intro Floating Pill -->
    <FrameLayout
        android:id="@+id/skipIntroContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:elevation="11dp"
        android:visibility="gone">

        <Button
            android:id="@+id/skipIntroButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sctv_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:minWidth="@dimen/skip_button_width"
            android:minHeight="@dimen/skip_button_height"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/skip_intro"
            android:textAllCaps="false"
            android:textColor="@color/sctv_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>

</FrameLayout>
