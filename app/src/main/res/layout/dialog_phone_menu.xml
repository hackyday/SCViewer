<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:minWidth="520dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/phoneMenuTitle"
        style="@style/SCTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_gravity="center_horizontal"
        android:textAlignment="center"
        android:text="@string/phone_menu_title" />

    <Button
        android:id="@+id/phoneMenuHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/menu_home"
        android:textColor="@color/sc_text_primary"
        android:textSize="18sp"
        android:singleLine="true" />

    <Button
        android:id="@+id/phoneMenuFavorites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/menu_favorites"
        android:textColor="@color/sc_text_primary"
        android:textSize="18sp"
        android:singleLine="true" />

    <Button
        android:id="@+id/phoneMenuHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/menu_history"
        android:textColor="@color/sc_text_primary"
        android:textSize="18sp"
        android:singleLine="true" />

    <Button
        android:id="@+id/phoneMenuResume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/menu_resume"
        android:textColor="@color/sc_text_primary"
        android:textSize="18sp"
        android:singleLine="true" />

    <Button
        android:id="@+id/phoneMenuSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/menu_settings"
        android:textColor="@color/sc_text_primary"
        android:textSize="18sp"
        android:singleLine="true" />

    <Button
        android:id="@+id/phoneMenuExit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/phone_menu_exit"
        android:textColor="@color/sc_text_secondary"
        android:textSize="16sp" />
</LinearLayout>
