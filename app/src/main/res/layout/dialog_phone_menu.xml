<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/phoneMenuTitle"
        style="@style/SCTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_gravity="center_horizontal"
        android:textAlignment="center"
        android:text="@string/phone_menu_title" />

    <!-- Riga Trasmetti: apre la scelta del Chromecast -->
    <LinearLayout
        android:id="@+id/phoneMenuCastRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/phoneMenuRouteBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:mediaRouteTypes="user" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/menu_cast"
            android:textColor="@color/sc_accent"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/phoneMenuHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/menu_home"
        android:textColor="@color/sc_text_primary"
        android:textSize="18sp" />

    <Button
        android:id="@+id/phoneMenuFavorites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/menu_favorites"
        android:textColor="@color/sc_text_primary"
        android:textSize="18sp" />

    <Button
        android:id="@+id/phoneMenuHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/menu_history"
        android:textColor="@color/sc_text_primary"
        android:textSize="18sp" />

    <Button
        android:id="@+id/phoneMenuResume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/menu_resume"
        android:textColor="@color/sc_text_primary"
        android:textSize="18sp" />

    <Button
        android:id="@+id/phoneMenuSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/menu_settings"
        android:textColor="@color/sc_text_primary"
        android:textSize="18sp" />

    <Button
        android:id="@+id/phoneMenuExit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/phone_menu_exit"
        android:textColor="@color/sc_text_secondary"
        android:textSize="16sp" />
</LinearLayout>
