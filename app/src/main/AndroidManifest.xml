<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Cast (C1): il discovery dei device Chromecast scandisce lo stato WiFi. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Cast (B): notifica di riproduzione remota — la mostra il framework
         durante il cast (e il controller per il percorso fake debug).
         Android 13+ la richiede a runtime in RemoteActivity; senza permesso
         nessuna notifica, nessun crash. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Auto-aggiornamento: avvio del package installer di sistema sull'APK
         scaricato (la conferma resta comunque all'utente). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.SCViewer"
        android:usesCleartextTraffic="true"
        tools:targetApi="33">

        <!-- Router del launcher (M1): decide fra SCtv e sito senza flash.
             Gli intent-filter MAIN/LAUNCHER sono stati MOSSI qui da
             MainActivity, che resta raggiungibile solo internamente. -->
        <activity
            android:name=".LauncherRouterActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Leanback launcher so it shows up on the Fire TV home row -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize" />

        <!-- Nuova interfaccia SCtv (M1): WebView fullscreen con asset locale
             + bridge. Il sito resta MainActivity (invariata). Sui telefoni
             carica mobile.html in portrait (richiesta runtime) — adjustResize
             serve alla ricerca col tastierino in modal portrait. -->
        <activity
            android:name=".SctvActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:theme="@style/Theme.SCViewer" />

        <!-- Interfaccia TV nativa (prototipo): avvio diretto via adb, non è
             ancora il launcher principale. -->

        <!-- Schermata di streaming SCtv: watch URL reale + controlli nativi. -->
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:theme="@style/Theme.SCViewer" />

        <!-- Cast (C1): il framework GMS individua l'OptionsProvider a runtime
             (chiamato SOLO su device con Google Play services — il codice cast
             non viene mai istanziato su Fire TV). -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.scviewer.fire.cast.CastOptionsProvider" />

        <!-- Cast (C2): telecomando della sessione Chromecast (phone mode).
             singleTop: il routing verso di lui non crea copie; portrait: è
             una schermata telefono. BACK chiude il telecomando ma la sessione
             cast resta viva (disconnect esplicito dall'icona). -->
        <activity
            android:name=".cast.RemoteActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:theme="@style/Theme.SCViewer" />

        <!-- Condivide l'APK scaricato col package installer di sistema. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Disable the default androidx.startup WorkManagerInitializer so the
             app's Configuration.Provider (App.kt) is the only source of
             WorkManager configuration. Without this, WorkManagerInitializer
             calls WorkManager.initialize() at app startup, and App.kt's
             onCreate() would then crash on a second initialize() call. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
