<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Cast (Chromecast, telefoni/tablet): senza il tipo di foreground
         service dichiarato, Android 14+ uccide l'app quando il framework
         promuove MediaNotificationService a foreground (media partita sul
         TV) — crash 1-2 s dopo l'avvio della trasmissione. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Fire TV is a TV-only platform. Declare so feature is required. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.SCViewer"
        android:usesCleartextTraffic="true"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Leanback launcher so it shows up on the Fire TV home row -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Disable the default androidx.startup WorkManagerInitializer so the
             app's Configuration.Provider (App.kt) is the only source of
             WorkManager configuration. Without this, WorkManagerInitializer
             calls WorkManager.initialize() at app startup, and App.kt's
             onCreate() would then crash on a second initialize() call. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Google Cast (telefoni/tablet): receiver options + telecomando -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.scviewer.fire.cast.CastOptionsProvider" />

        <!-- Android 14+: il framework Cast promuove questi servizi a
             foreground quando il media parte sul TV — senza
             foregroundServiceType="mediaPlayback" l'app crasha. -->
        <service
            android:name="com.google.android.gms.cast.framework.media.MediaNotificationService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <service
            android:name="com.google.android.gms.cast.framework.ReconnectionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:name=".cast.CastRemoteActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SCViewer" />

    </application>
</manifest>
